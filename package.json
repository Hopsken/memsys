{
  "name": "memsys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint && pnpm format:check",
    "db:generate": "drizzle-kit generate --name",
    "db:generate:memory": "drizzle-kit generate --config worker/memory-do/drizzle.config.ts --name",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "curl -fsS -X POST -H 'Content-Type: application/json' -d \"{\\\"email\\\":\\\"$SEED_EMAIL\\\"}\" \"${SEED_URL:-http://localhost:5173}/api/dev/seed\" && echo",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "dev": "pnpm db:migrate:local && vite dev",
    "eval": "vitest run --config eval/vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typegen": "wrangler types --strict-vars false --env-file .dev.vars.example"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.5",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.7",
    "ky": "^2.1.0",
    "lucide-react": "^1.45.0",
    "nanoid": "^6.0.1",
    "porter2": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "packageManager": "pnpm@11.21.0"
}
