{
  "name": "memsys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint && pnpm format:check",
    "db:generate": "drizzle-kit generate --name",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typegen": "wrangler types --strict-vars false"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "packageManager": "pnpm@11.21.0"
}
